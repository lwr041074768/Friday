{
  "extends": "./tsconfig.json",
  "compilerOptions": {"paths":{
    "@/components/lsv-origin-export":["./desktop/renderer/lsv-origin-export.tsx"],
    "@/components/xy-origin-export":["./desktop/renderer/xy-origin-export.tsx"],
    "@/components/overpotential-origin-export":["./desktop/renderer/overpotential-origin-export.tsx"],
